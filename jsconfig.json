{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "$components/*": ["./src/components/*"],
      "$composables/*": ["./src/composables/*"],
      "$data/*": ["./src/data/*"],
      "$services/*": ["./src/services/*"],
      "$stores/*": ["./src/stores/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
